# docker-compose up 전에 이 파일을 .env로 복사하세요: cp .env.example .env
# db, backend 두 서비스가 이 값을 공유해서 씁니다 (docker-compose.yml 참고).

MYSQL_DATABASE=teambuild
MYSQL_USER=teambuild
MYSQL_PASSWORD=teambuild
MYSQL_ROOT_PASSWORD=changeme-root

# 필수. 없으면 Django가 아예 안 뜹니다. 아래 명령으로 새로 생성하세요:
#   docker compose run --rm backend python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 주의: 생성된 값에 $ 가 들어있으면 docker-compose가 변수 참조로 오인해서
# 그 뒤 문자를 조용히 지워버립니다. $ 없는 값이 나올 때까지 다시 돌리세요.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 카카오 디벨로퍼스(developers.kakao.com)에서 발급받아 채우세요.
# 비워두면 로그인 버튼을 눌렀을 때 카카오가 요청을 거부합니다(그 외 기능엔 영향 없음).
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/kakao/callback/
